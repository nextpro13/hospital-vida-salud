{
  "info": {
    "name": "Hospital Vida Salud - T2",
    "description": "Flujo funcional completo a través del API Gateway. Datos ficticios.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get(\"dni\")) {",
          "  pm.collectionVariables.set(\"dni\", \"7\" + String(Math.floor(Math.random()*1e7)).padStart(7, \"0\"));",
          "  pm.collectionVariables.set(\"profesional\", \"MED-\" + String(Math.floor(Math.random()*1000)).padStart(3, \"0\"));",
          "  pm.collectionVariables.set(\"operacion\", \"OP-\" + Date.now());",
          "  const d = new Date(); d.setDate(d.getDate() + ((8 - d.getDay()) % 7 || 7));",
          "  pm.collectionVariables.set(\"fechaCita\", d.toISOString().substring(0,10) + \"T10:30:00\");",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Pacientes",
      "item": [
        {
          "name": "Registrar paciente (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway}}/api/pacientes",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "api",
                "pacientes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipoDocumento\": \"DNI\",\n  \"numeroDocumento\": \"{{dni}}\",\n  \"nombres\": \"Lucia\",\n  \"apellidos\": \"Ficticia Demo\",\n  \"fechaNacimiento\": \"1992-03-15\",\n  \"telefono\": \"999111222\",\n  \"correo\": \"lucia.demo@correo-ficticio.pe\",\n  \"direccion\": \"Calle Ejemplo 100\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"pacienteId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
